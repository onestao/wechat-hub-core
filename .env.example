# WeChatAgent release configuration.
# Copy this file to .env, then adjust the values for your NAS or computer.

COMPOSE_PROJECT_NAME=wechat-agent
TZ=Asia/Shanghai
PUID=1000
PGID=100

# Browser WeChat container.
# Leave WECHAT_SELKIES_PLATFORM empty for automatic host-architecture selection.
# Supported upstream platforms verified for this tag: linux/amd64 and linux/arm64.
WECHAT_SELKIES_IMAGE=ghcr.io/nickrunning/wechat-selkies:0.0.12-minimal
WECHAT_SELKIES_PLATFORM=
AUTO_START_WECHAT=true
AUTO_START_QQ=false
SHM_SIZE=1gb

# Browser access. Keep 127.0.0.1 for local-only access; use 0.0.0.0 for LAN access.
HTTP_BIND=127.0.0.1
HTTP_PORT=3000
HTTPS_BIND=127.0.0.1
HTTPS_PORT=3001
AGENT_CONSOLE_BIND=127.0.0.1
AGENT_CONSOLE_PORT=8078
AI_MEMORY_BIND=127.0.0.1
AI_MEMORY_PORT=8090
CORE_BIND=127.0.0.1
CORE_PORT=8080

# Optional web password used by the Selkies image. Set a strong value before exposing to LAN.
PASSWORD=
CUSTOM_USER=

# Project service image. Override this if you publish under another DockerHub namespace.
WECHAT_AGENT_IMAGE=docker.io/xiaoguiwucan/linux-wechat-agent:latest

# Filled by scripts/detect-wechat-account.sh after the first WeChat login.
WECHAT_ACCOUNT_DIR_NAME=PLEASE_SET_WECHAT_ACCOUNT_DIR

# Account-aware Core. Copy core/accounts.example.json to
# runtime/core/accounts.json and add every account before starting this service.
# The legacy single-account services remain available only through the
# `legacy` Compose profile during migration.
CORE_SYNC_INTERVAL=5
# Keep sender disabled until Runtime provides an account-aware controller path.
CORE_SEND_INTERVAL=0

# Worker intervals.
MEMORY_SYNC_INTERVAL=5
AI_MEMORY_INTERVAL=5
